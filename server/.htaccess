# Wolf Wheels: solo se pueden usar api.php y logo.png (config.php y data/ quedan cerradas)
Options -Indexes
<FilesMatch "^(?!(api\.php|logo\.png)$).*">
    Require all denied
</FilesMatch>
# Deja pasar la cabecera Authorization a PHP
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
